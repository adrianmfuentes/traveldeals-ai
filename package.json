{
  "name": "traveldeals-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "prisma generate && cross-env NODE_OPTIONS=\"--no-deprecation\" node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/next/dist/bin/next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "worker:dev": "cross-env NODE_PATH=./node_modules tsx watch worker/src/index.ts",
    "worker:start": "cross-env NODE_PATH=./node_modules tsx worker/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:report": "bash scripts/run-tests.sh --coverage",
    "security:check": "bash scripts/security-check.sh",
    "security:fix": "bash scripts/security-check.sh --fix",
    "docker:build": "docker compose build",
    "docker:up": "docker compose --env-file .env up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@platform/core": "file:../platform-core",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.12.0",
    "date-fns": "^3.6.0",
    "groq-sdk": "^1.1.1",
    "ioredis": "5.10.1",
    "lucide-react": "^0.400.0",
    "next": "^15.5.14",
    "next-auth": "^4.24.13",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "resend": "^6.9.4",
    "zod": "^3.23.0"
  },
  "overrides": {
    "ioredis": "5.10.1"
  },
  "devDependencies": {
    "@swc/helpers": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.14",
    "postcss": "^8.4.0",
    "prisma": "^7.5.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0"
  }
}
